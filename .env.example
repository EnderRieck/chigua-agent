# ======== LLM 编排（Grok，经 OpenAI 兼容协议）========
# 国内中转站：填中转站给你的地址（通常以 /v1 结尾）和 Key；官方直连则为 https://api.x.ai/v1
XAI_API_KEY=sk-xxxx
XAI_BASE_URL=https://api.x.ai/v1
# 中转站里 Grok 的模型名，常见：grok-4.3 / grok-4.7 / grok-4 等，以中转站模型列表为准
XAI_MODEL=grok-4.3
# 是否流式输出（个别中转站流式不稳定时改为 0）
LLM_STREAM=1

# X 平台搜索方式：auto（依次尝试 responses → live → deepseek）| responses | live | deepseek
# responses = xAI Responses API 的服务端工具 x_search（官方直连可用，中转站多半不支持）
# live      = 旧版 chat.completions 的 search_parameters（部分中转站可透传）
# deepseek  = 用 DeepSeek 搜索 site:x.com 兜底
X_SEARCH_MODE=auto
# xAI x_search 单次最多等多少秒，超时自动转 DeepSeek 兜底（官方工具偶尔要 60s+）
X_SEARCH_TIMEOUT=75

# ======== 联网搜索（DeepSeek Search / Fetch API）========
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ======== 社交媒体（全部可选）========
# 微博：留空则热搜用公开镜像、关键词搜索走 DeepSeek site:weibo.com；
# 填入你自己浏览器里 weibo.com 的 Cookie 后可直连微博接口（仅用于你本人账号）
WEIBO_COOKIE=
# 知乎：热榜免登录；填入你自己浏览器里 zhihu.com 的完整 Cookie（需含 d_c0、z_c0）后，
# 站内搜索与问题回答直连（本地计算 x-zse-96 签名），否则搜索走 DeepSeek site:zhihu.com
ZHIHU_COOKIE=
# 小红书：运行 xpzouying/xiaohongshu-mcp（扫码登录）后填其 MCP 地址；留空则走 DeepSeek site:xiaohongshu.com
XHS_MCP_URL=
XHS_MCP_TOKEN=

# ======== 运行参数 ========
# 分析员最多追加几轮工具调用
MAX_TOOL_ROUNDS=4
REQUEST_TIMEOUT=40
